-- ======= نظام التوقع =======
local function getPredictedPosition(targetPlayer, offset)
    local targetChar = targetPlayer.Character
    if not targetChar then return nil end
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local velocity = hrp.Velocity
    local distance = (hrp.Position - localplayer.Character.HumanoidRootPart.Position).Magnitude
    local bulletSpeed = 300 
    local timeToHit = distance / bulletSpeed
    local predictedPos = hrp.Position + velocity * timeToHit
    if offset then predictedPos = predictedPos + Vector3.new(0, offset, 0) end
    return predictedPos
end

local function findMurderer()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v.Character and (v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife")) then return v end
    end
    return nil
end

local function findSheriff()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= localplayer and v.Character and (v.Character:FindFirstChild("Gun") or v.Backpack:FindFirstChild("Gun")) then return v end
    end
    return nil
end

-- دالة إنشاء الأزرار المستطيلة
local function CreateRectBtn(name, color, pos, callback)
    local Gui = Instance.new("ScreenGui", game.CoreGui)
    local Btn = Instance.new("TextButton", Gui)
    Btn.Size = UDim2.new(0, 110, 0, 35)
    Btn.Position = pos
    Btn.Text = name
    Btn.BackgroundColor3 = color
    Btn.TextColor3 = Color3.new(1, 1, 1)
    Btn.Draggable = true; Btn.Active = true
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    Btn.MouseButton1Click:Connect(callback)
    return Gui
end

local ShootGui, KillAllGui, SheriffGui

-- ======= تاب قتال | Combat Tab =======

CombatTab:CreateToggle({
   Name = "إظهار زر إطلاق النار | Show SHOOT Button",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         ShootGui = CreateRectBtn("SHOOT MURDER", Color3.fromRGB(180, 0, 0), UDim2.new(0.5, 0, 0.4, 0), function()
            local murderer = findMurderer()
            local gun = localplayer.Backpack:FindFirstChild("Gun") or localplayer.Character:FindFirstChild("Gun")
            if murderer and gun then
                localplayer.Character.Humanoid:EquipTool(gun)
                local predictedPosition = getPredictedPosition(murderer, 1)
                local args = {CFrame.new(localplayer.Character.RightHand.Position), CFrame.new(predictedPosition)}
                localplayer.Character:WaitForChild("Gun"):WaitForChild("Shoot"):FireServer(unpack(args))
            end
         end)
      else if ShootGui then ShootGui:Destroy() end end
   end,
})

CombatTab:CreateToggle({
   Name = "إظهار زر قتل الكل | Show KILL ALL Button",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         KillAllGui = CreateRectBtn("KILL ALL", Color3.fromRGB(50, 0, 0), UDim2.new(0.5, 0, 0.5, 0), function()
