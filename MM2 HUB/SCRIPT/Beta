   Title = L.TouchFling,
   Value = false,
   Callback = function(Value)
      hiddenfling = Value
      _G.FollowActive = false
   end,
})
FlingTab:Toggle({
   Title = L.FlingMurder,
   Value = false,
   Callback = function(Value)
      _G.KM_Fling = Value
      if Value then
          local t = findMurderer()
          if t and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
              originalPos = LP.Character.HumanoidRootPart.CFrame
              hiddenfling = true; _G.FollowActive = true
              task.spawn(function()
                  while _G.KM_Fling and t.Character and t.Character:FindFirstChild("HumanoidRootPart") do
                      LP.Character.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame
                      task.wait()
                  end
                  hiddenfling = false; _G.FollowActive = false
                  if originalPos and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                     LP.Character.HumanoidRootPart.CFrame = originalPos
                  end
              end)
          end
      else hiddenfling = false end
   end,
})
