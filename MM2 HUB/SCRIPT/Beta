local function ApplyFlingLogic(targetMove)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local vel = hrp.Velocity
        hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
        RunService.RenderStepped:Wait()
        if hrp and hrp.Parent then hrp.Velocity = vel end
        RunService.Stepped:Wait()
        if hrp and hrp.Parent then
            hrp.Velocity = vel + Vector3.new(0, 0.1, 0)
        end
        if targetMove then
            hrp.CFrame = hrp.CFrame * CFrame.new(math.random(-3,3), math.random(-2,2), math.random(-3,3))
        end
    end
end
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if hiddenfling then ApplyFlingLogic(_G.FollowActive) end
    end
end)
local function findMurderer()
    if Murder and Players:FindFirstChild(Murder) then return Players[Murder] end
    for _, v in pairs(Players:GetPlayers()) do
        if v.Character and (v.Character:FindFirstChild("Knife") or (v:FindFirstChild("Backpack") and v.Backpack:FindFirstChild("Knife"))) then return v end
    end
    return nil
end
local function findSheriff()
    if Sheriff and Players:FindFirstChild(Sheriff) then return Players[Sheriff] end
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LP and v.Character and (v.Character:FindFirstChild("Gun") or (v:FindFirstChild("Backpack") and v.Backpack:FindFirstChild("Gun"))) then return v end
    end
    return nil
end
local function GetPlayerNamesList()
    local names = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(names, p.Name) end
    end
    return names
end
local function CreateRectBtn(name, color, pos, callback)
    local Gui = Instance.new("ScreenGui", game.CoreGui)
    local Btn = Instance.new("TextButton", Gui)
    Btn.Size = UDim2.new(0, 120, 0, 35); Btn.Position = pos; Btn.Text = name
    Btn.BackgroundColor3 = color; Btn.TextColor3 = Color3.new(1, 1, 1)
    Btn.Draggable = true; Btn.Active = true
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    Btn.MouseButton1Click:Connect(callback)
    return Gui
end
local function CreateHighlight()
    for i, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character and not v.Character:FindFirstChild("LuxAdkHighlight") then
            local hl = Instance.new("Highlight", v.Character)
            hl.Name = "LuxAdkHighlight"
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0.1
        end
        if v ~= LP and v.Character and v.Character:FindFirstChild("Head") and not v.Character.Head:FindFirstChild("LuxAdk_ESP_Tag") then
            local bg = Instance.new("BillboardGui", v.Character.Head)
            bg.Name = "LuxAdk_ESP_Tag"
            bg.Size = UDim2.new(0, 150, 0, 30)
            bg.StudsOffset = Vector3.new(0, 2.5, 0)
            bg.AlwaysOnTop = true
            local txt = Instance.new("TextLabel", bg)
            txt.Name = "Label"
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = Color3.new(1, 1, 1)
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.SourceSansBold
            txt.TextSize = 14
        end
    end
end
local function IsAlive(Player)
    if not roles then return false end
    for i, v in pairs(roles) do
        if Player.Name == i then
            if not v.Killed and not v.Dead then
                return true
            else
                return false
            end
        end
    end
    return false
end
local function UpdateHighlights()
    for _, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character then
            local Highlight = v.Character:FindFirstChild("LuxAdkHighlight")
            if Highlight then
                local sheriffPlayer = Sheriff and Players:FindFirstChild(Sheriff)
                local isSheriffDead = not sheriffPlayer or not IsAlive(sheriffPlayer)
                local drop = Workspace:FindFirstChild("GunDrop", true) or Workspace:FindFirstChild("Pickup", true)
                local isGunDropped = (drop ~= nil)
                if v.Name == Murder and IsAlive(v) then
                    Highlight.FillColor = Color3.fromRGB(225, 0, 0)
                elseif v.Name == Sheriff and IsAlive(v) and not isGunDropped then
                    Highlight.FillColor = Color3.fromRGB(0, 0, 225)
                elseif (v.Name == Hero or v.Name == Sheriff) and IsAlive(v) and (isSheriffDead or isGunDropped) then
                    Highlight.FillColor = Color3.fromRGB(255, 250, 0)
                else
                    Highlight.FillColor = Color3.fromRGB(0, 225, 0)
                end
            end
            local head = v.Character:FindFirstChild("Head")
            if head and head:FindFirstChild("LuxAdk_ESP_Tag") then
                local lbl = head.LuxAdk_ESP_Tag:FindFirstChild("Label")
                if lbl then
                    local str = ""
                    if espNames then str = str.. v.Name end
                    if espDistance and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((head.Position - LP.Character.HumanoidRootPart.Position).Magnitude)
                        str = str.. (espNames and " [" or "[").. dist.. "m]"
                    end
                    lbl.Text = str
                    if Highlight then lbl.TextColor3 = Highlight.FillColor end
                end
            end
        end
    end
end
local function RemoveHighlights()
    for _, v in pairs(Players:GetChildren()) do
        if v.Character then
            if v.Character:FindFirstChild("LuxAdkHighlight") then
                v.Character.LuxAdkHighlight:Destroy()
            end
            if v.Character:FindFirstChild("Head") and v.Character.Head:FindFirstChild("LuxAdk_ESP_Tag") then
                v.Character.Head.LuxAdk_ESP_Tag:Destroy()
            end
        end
    end
end
local PlayEmoteRemote
pcall(function()
    PlayEmoteRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Misc"):WaitForChild("PlayEmote")
end)
local function PlayMM2Emote(Name)
    if not PlayEmoteRemote then
        pcall(function()
            PlayEmoteRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Misc"):WaitForChild("PlayEmote")
        end)
    end
    if PlayEmoteRemote then
        pcall(function() PlayEmoteRemote:Fire(Name) end)
    end
end
local CoinFarmEnabled = false
local CoinFarmThread = nil
local CurrentTween = nil
local COIN_FARM_SPEED = 25
local LobbyPositions = {
    Vector3.new(-2.63, -64.76, -74.82),
    Vector3.new(0.19, -56.15, -12.80),
    Vector3.new(-0.64, -67.14, 45.71)
}
local LOBBY_RADIUS = 250
local function NotifyLobby()
    WindUI:Notify({ Title = "Coin Farm", Content = "أنت ميت، أنت باللوبي.", Duration = 3 })
end
local function IsAliveChar()
    local Character = LP.Character
    if not Character then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then return false end
    return Humanoid.Health > 0
end
local function IsInLobby()
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Root then return true end
    for _, Position in ipairs(LobbyPositions) do
        if (Root.Position - Position).Magnitude <= LOBBY_RADIUS then
            return true
        end
    end
    return false
end
local function CanFarm()
    if not IsAliveChar() then return false end
    if IsInLobby() then return false end
    return true
end
local function GetCurrentMap()
    for _, Map in ipairs(Workspace:GetChildren()) do
        if Map:GetAttribute("MapID") and Map:FindFirstChild("CoinContainer") then
            return Map
        end
    end
    return nil
end
local function GetCoinPosition(Coin)
    if not Coin or not Coin.Parent then return nil end
    local Success, Position = pcall(function()
        if Coin:IsA("BasePart") then return Coin.Position end
        return Coin:GetPivot().Position
    end)
    return Success and Position or nil
end
local function IsCoinAvailable(Coin)
    if not Coin or not Coin.Parent then return false end
    local Visual = Coin:FindFirstChild("CoinVisual")
    if not Visual then return false end
    if Visual:GetAttribute("Collected") then return false end
    return true
end
local function FindNearestCoin(Position)
    local Map = GetCurrentMap()
    if not Map then return nil end
    local Container = Map:FindFirstChild("CoinContainer")
    if not Container then return nil end
    local Nearest = nil
    local NearestDistance = math.huge
    for _, Coin in ipairs(Container:GetChildren()) do
        if IsCoinAvailable(Coin) then
            local CoinPosition = GetCoinPosition(Coin)
            if CoinPosition then
                local Distance = (Position - CoinPosition).Magnitude
                if Distance < NearestDistance then
                    NearestDistance = Distance
                    Nearest = Coin
                end
            end
        end
    end
    return Nearest
end
local function StopCoinFarm()
    CoinFarmEnabled = false
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
    if CoinFarmThread then
        task.cancel(CoinFarmThread)
        CoinFarmThread = nil
    end
end
local function TweenToCoin(Coin, Root)
    if not Coin or not Root or not CoinFarmEnabled or not CanFarm() then return false end
    local TargetPosition = GetCoinPosition(Coin)
    if not TargetPosition then return false end
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 0.15 then return true end
    local Duration = Distance / COIN_FARM_SPEED
    CurrentTween = TweenService:Create(Root, TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {CFrame = CFrame.new(TargetPosition)})
    local Finished = false
    local Connection = CurrentTween.Completed:Connect(function() Finished = true end)
    CurrentTween:Play()
    while CoinFarmEnabled and not Finished do
        if not CanFarm() then
            CurrentTween:Cancel()
            Connection:Disconnect()
            CurrentTween = nil
            return false
        end
        if not Root.Parent then
            CurrentTween:Cancel()
            Connection:Disconnect()
            CurrentTween = nil
            return false
        end
        task.wait()
    end
    Connection:Disconnect()
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing then
        CurrentTween:Cancel()
    end
    CurrentTween = nil
    return Finished
end
local function StartCoinFarm()
    if not CanFarm() then
        NotifyLobby()
        return
    end
    if CoinFarmThread then return end
    CoinFarmEnabled = true
    CoinFarmThread = task.spawn(function()
        while CoinFarmEnabled do
            if not CanFarm() then
                CoinFarmEnabled = false
                if CurrentTween then pcall(function() CurrentTween:Cancel() end); CurrentTween = nil end
                NotifyLobby()
                break
            end
            local Char = LP.Character
            local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            if not Char or not Hum or not Root or Hum.Health <= 0 then
                task.wait(0.5)
            else
                local Coin = FindNearestCoin(Root.Position)
                if Coin then
                    TweenToCoin(Coin, Root)
                    task.wait(0.05)
                else
                    task.wait(0.25)
                end
            end
        end
        CoinFarmThread = nil
    end)
end
LP.CharacterAdded:Connect(function(Character)
    local Humanoid = Character:WaitForChild("Humanoid", 10)
    if Humanoid then
        Humanoid.Died:Connect(function()
            if CoinFarmEnabled then
                StopCoinFarm()
                NotifyLobby()
            end
        end)
    end
end)
if LP.Character then
    local Humanoid = LP.Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        Humanoid.Died:Connect(function()
            if CoinFarmEnabled then
                StopCoinFarm()
                NotifyLobby()
            end
        end)
    end
end
