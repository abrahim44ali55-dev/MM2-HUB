local playerDropdown = FlingTab:Dropdown({
   Title = L.SelectTarget,
   Values = GetPlayerNamesList(),
   Callback = function(selected) selectedPlayerName = selected end,
})
FlingTab:Button({ Title = L.RefreshList, Callback = function() playerDropdown:SetValues(GetPlayerNamesList()) end })
FlingTab:Toggle({
   Title = L.TargetFling,
   Value = false,
   Callback = function(Value)
      targetFlingActive = Value
      if targetFlingActive then
          if not selectedPlayerName then return end
          local targetObj = Players:FindFirstChild(selectedPlayerName)
          if targetObj and targetObj.Character and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
              originalPos = LP.Character.HumanoidRootPart.CFrame
              hiddenfling = true; _G.FollowActive = true
              task.spawn(function()
                  while targetFlingActive and targetObj.Character and targetObj.Character:FindFirstChild("HumanoidRootPart") do
                      LP.Character.HumanoidRootPart.CFrame = targetObj.Character.HumanoidRootPart.CFrame
                      task.wait()
                  end
                  hiddenfling = false; _G.FollowActive = false
                  if originalPos and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                     LP.Character.HumanoidRootPart.CFrame = originalPos
                  end
              end)
          end
      else
          hiddenfling = false; _G.FollowActive = false
      end
   end,
})
