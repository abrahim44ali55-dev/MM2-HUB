MurderTab:Toggle({
   Title = L.AutoKillSheriff,
   Value = false,
   Callback = function(v)
      _G.AutoKillSheriff = v
      task.spawn(function()
          while _G.AutoKillSheriff do
              local s = findSheriff()
              local k = LP.Backpack:FindFirstChild("Knife") or LP.Character:FindFirstChild("Knife")
              if s and s.Character and k and LP.Character:FindFirstChild("HumanoidRootPart") then
                  LP.Character.Humanoid:EquipTool(k)
                  LP.Character.HumanoidRootPart.CFrame = s.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1)
                  k:Activate()
              end
              task.wait(0.1)
          end
      end)
   end,
})
SheriffTab:Toggle({
   Title = L.ShootMurder,
   Value = false,
   Callback = function(Value)
      if Value then
         _G.ShootGui = CreateRectBtn("SHOOT MURDER", Color3.fromRGB(0, 100, 255), UDim2.new(0.5, -60, 0.3, 0), function()
            local murderer = findMurderer()
            local gun = LP.Backpack:FindFirstChild("Gun") or LP.Character:FindFirstChild("Gun")
            if murderer and gun then
                LP.Character.Humanoid:EquipTool(gun)
                local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local args = {CFrame.new(LP.Character.RightHand.Position), CFrame.new(hrp.Position)}
                    LP.Character:WaitForChild("Gun"):WaitForChild("Shoot"):FireServer(unpack(args))
                end
            end
         end)
      else if _G.ShootGui then _G.ShootGui:Destroy() end end
   end,
})
SheriffTab:Toggle({
   Title = L.GetGunBtn,
   Value = false,
   Callback = function(Value)
      if Value then
         _G.GetGBtn = CreateRectBtn("GET GUN", Color3.fromRGB(200, 150, 0), UDim2.new(0.5, -60, 0.4, 0), function()
            local drop = Workspace:FindFirstChild("GunDrop", true) or Workspace:FindFirstChild("Pickup", true)
            if drop and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
               drop.CFrame = LP.Character.HumanoidRootPart.CFrame
            end
         end)
      else if _G.GetGBtn then _G.GetGBtn:Destroy() end end
   end,
})
