   Title = L.FlingSheriff,
   Value = false,
   Callback = function(Value)
      _G.KS_Fling = Value
      if Value then
          local t = findSheriff()
          if t and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
