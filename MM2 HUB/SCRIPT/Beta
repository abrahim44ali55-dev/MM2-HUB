MurderTab:Input({
   Title = L.HitboxSize,
   Default = "15",
   Placeholder = "5 - 50...",
   Callback = function(txt)
      local n = tonumber(txt)
      if n then
          if n < 5 then n = 5 end
          if n > 50 then n = 50 end
          hitboxSize = n
      end
   end
})
MurderTab:Toggle({
   Title = L.HitboxToggle,
   Value = false,
   Callback = function(val)
      hitboxEnabled = val
      task.spawn(function()
          while hitboxEnabled do
              for _, p in pairs(Players:GetPlayers()) do
                  if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                      p.Character.HumanoidRootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                      p.Character.HumanoidRootPart.Transparency = 0.7
                      p.Character.HumanoidRootPart.BrickColor = BrickColor.new("Really red")
                      p.Character.HumanoidRootPart.CanCollide = false
                  end
              end
              task.wait(0.5)
          end
          for _, p in pairs(Players:GetPlayers()) do
              if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                  p.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
                  p.Character.HumanoidRootPart.Transparency = 1
              end
          end
      end)
   end
})
MurderTab:Toggle({
   Title = L.KillAll,
   Value = false,
   Callback = function(Value)
      if Value then
         _G.KAGui = CreateRectBtn("KILL ALL", Color3.fromRGB(150, 0, 0), UDim2.new(0.5, -60, 0.2, 0), function()
            local k = LP.Backpack:FindFirstChild("Knife") or LP.Character:FindFirstChild("Knife")
            if k then
                LP.Character.Humanoid:EquipTool(k)
                task.spawn(function()
                    local savedPositions = {}
                    for _, v in pairs(Players:GetPlayers()) do
                        if v ~= LP and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                            savedPositions[v.Name] = v.Character.HumanoidRootPart.CFrame
                            v.Character.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1.2)
                        end
                    end
                    for i = 1, 20 do
                        if not _G.KAGui then break end
                        k:Activate()
                        task.wait(0.05)
                    end
                    task.wait(3)
                    for _, v in pairs(Players:GetPlayers()) do
                        if savedPositions[v.Name] and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChildOfClass("Humanoid") and v.Character.Humanoid.Health > 0 then
                            v.Character.HumanoidRootPart.CFrame = savedPositions[v.Name]
                        end
                    end
                end)
            end
         end)
      else if _G.KAGui then _G.KAGui:Destroy() end end
   end,
})
